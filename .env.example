# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- API keys ---
# Google Gemini (cooking-time estimate + ingredient normalization)
GOOGLE_API_KEY=
# DeepL translation (Dutch -> English)
DEEPL_API_KEY=
# USDA FoodData Central (nutrition data). Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# --- Email (Gmail) ---
# Gmail App Password (NOT your normal password): https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
SENDER_EMAIL=you@gmail.com
# Comma-separated list of recipients
RECIPIENTS=you@gmail.com,someone@example.com

# --- Optional overrides ---
# Which weekbox: vegan | vega | weekbox | snelle | snelle-vega
# CRISP_BOX=vegan
# DeepL target language
# TARGET_LANG=EN-GB
# Portions the ingredient/step amounts are written for (the site publishes 2)
# TARGET_PORTIONS=4
